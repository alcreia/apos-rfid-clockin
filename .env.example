# --- server ---
PORT=3000
TZ_NAME=Asia/Jakarta

# stub = record taps locally, never call Google (default, safe)
# live  = append rows to the real spreadsheet
SHEETS_MODE=stub

# live mode only
SHEET_ID=
SHEET_TAB=Log
SA_KEY_PATH=secrets/sa.json

# dev tools (/dev page, enroll endpoint). Set to 0 on the live kiosk.
DEV=1

# 1 (or absent) = open the fullscreen kiosk at logon — what the door PC wants.
# 0            = start only the server; open the page yourself on a shared machine.
KIOSK_AUTOSTART=1
